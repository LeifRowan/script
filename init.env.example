# =============================================================================
# server-init 配置模板
#
# 用法:  cp init.env.example init.env && chmod 600 init.env && vim init.env
#        sudo bash init.sh --config init.env
#
# 规则:
#   - 只解析 KEY=VALUE, 不会被 source 执行 (远程配置同理), 不支持 $VAR 展开
#   - 优先级: 环境变量 > --config 本地文件 > --config-url 远程文件 > 交互输入 > 默认值
#   - 注释掉的项 = 未设置: 交互模式下会询问, 非交互模式取默认值
#   - 写成 KEY= (空值) = 已设置为空, 不会再询问
#   - yes/no 类取值: yes|y|true|1 视为 yes, 其他视为 no
#   - 行尾注释: 未加引号时 "空白 + #" 之后视为注释; 值里需要 " #" 时请加引号
#   - 所有取值在开始执行前统一校验, 格式错误会直接退出, 不会改到一半才失败
# =============================================================================

# ---- 运行控制 ---------------------------------------------------------------
# 非交互模式 (cloud-init / 批量初始化时用)
#NONINTERACTIVE=no
# 在未验证的系统版本上强制执行; 也用于确认 SSH 白名单不含当前来源 IP 时仍继续
#FORCE=no
# 完成后如需重启是否自动重启 (仅非交互模式; 交互模式会询问)
#AUTO_REBOOT=no

# ---- 模块开关 (默认全部 yes) ------------------------------------------------
#ENABLE_UPDATE=yes
#ENABLE_BASELINE=yes
#ENABLE_PACKAGES=yes
#ENABLE_USER=yes
#ENABLE_UFW=yes
#ENABLE_SSH=yes
#ENABLE_FAIL2BAN=yes
#ENABLE_DOCKER=yes
#ENABLE_SWAP=yes
#ENABLE_SHELL_ENV=yes

# ---- 基线 -------------------------------------------------------------------
#TIMEZONE=UTC
#JOURNALD_MAX_USE=500M

# ---- 软件包 -----------------------------------------------------------------
# auto: 内存 >=2G 且根分区可用 >=10G 装 standard, 否则 minimal
#PACKAGE_PROFILE=auto
# 额外软件包, 空格分隔
#EXTRA_PACKAGES="tcpdump strace"

# ---- 用户 -------------------------------------------------------------------
NEW_USER=ops
#USER_SUDO=yes
#USER_SUDO_NOPASSWD=no
# 密码 (用于 sudo)。推荐用 hash, 生成方式: openssl passwd -6
# hash 里的 $ 不需要转义 (本文件不做变量展开), 但如果用环境变量传入要用单引号
#USER_PASSWORD_HASH='$6$xxxxxxxx$yyyyyyyy'
# 明文密码: 不要放进公开仓库 / 远程配置
#USER_PASSWORD=

# ---- SSH --------------------------------------------------------------------
# 从 https://github.com/<user>.keys 拉取公钥, 多个用空格分隔
# 也可以直接填 https 链接 (内容为 authorized_keys 格式的公钥列表), 可与用户名混用
#SSH_GITHUB_USERS="your-github-name https://raw.githubusercontent.com/<you>/<repo>/main/keys.pub"
# 直接写公钥, 多个用 ; 分隔。不支持 ssh-dss (OpenSSH 已弃用) 和小于 1024 位的 RSA
#SSH_PUBLIC_KEYS="ssh-ed25519 AAAA... me@laptop;ssh-ed25519 AAAA... me@desktop"
# 新 SSH 端口, 留空/不设置则沿用上次执行的端口, 再没有则随机 20000-32767 (避开 Linux 临时端口范围)
#SSH_PORT=
# 服务端保活: 每 60s 探测一次, 10 次无响应才断开
#SSH_CLIENT_ALIVE_INTERVAL=60
#SSH_CLIENT_ALIVE_COUNT_MAX=10
# 非交互模式下是否直接锁定 (禁 root / 禁密码 / 关旧端口)。
# 默认 no: 保持过渡状态, 你验证登录后再执行 init.sh --ssh-lockdown
# (--ssh-lockdown 在非交互模式下直接执行, 不需要再设置本项)
# 锁定后再改 SSH_PORT: 认证保持仅公钥, 新旧端口暂时同时监听, 同样验证后再锁定
#SSH_LOCKDOWN=no

# ---- UFW --------------------------------------------------------------------
# SSH 白名单 IP/CIDR, 空格分隔, 留空表示任意 IP。同时加入 fail2ban ignoreip
# 当前 SSH 连接的来源 IP 不在白名单内时会中止 (防止锁死), 确认无误可设 FORCE=yes
#SSH_ALLOW_IPS="203.0.113.10 198.51.100.0/24"
#UFW_ALLOW_HTTP=no
#UFW_ALLOW_HTTPS=no
# 其他端口, 空格分隔, 如 "8080/tcp 51820/udp 6000:6007/tcp" (端口范围必须带协议)
#UFW_ALLOW_PORTS=

# ---- fail2ban (默认严格模式) ------------------------------------------------
#F2B_MAXRETRY=3
#F2B_FINDTIME=10m
#F2B_BANTIME=24h
#F2B_BANTIME_MAX=4w

# ---- Docker -----------------------------------------------------------------
# 把 NEW_USER 加入 docker 组 (等同 root 权限)
# 默认: ENABLE_USER=yes 时 yes (交互模式会询问); ENABLE_USER=no 时 no
#DOCKER_USER_GROUP=yes
#DOCKER_LOG_MAX_SIZE=50m
#DOCKER_LOG_MAX_FILE=3

# ---- swap -------------------------------------------------------------------
# auto: 内存<=2G 取 2 倍; 2-8G 取等量; >8G 取 4G; 不超过根分区可用空间的 25%
# 也可以写 2G / 1024M, 0 表示不加。已有 swap 时自动跳过; auto 时磁盘空间不足也自动跳过
#SWAP_SIZE=auto
# 0-200
#SWAPPINESS=10

# ---- Shell 环境 -------------------------------------------------------------
# global: root + 所有普通用户 + /etc/skel; users: 只对 SHELL_ENV_USERS 生效
#SHELL_ENV_SCOPE=global
#SHELL_ENV_USERS="ops root"
